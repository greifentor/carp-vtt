	@Override
	public ${ClassName} getCurrentContent() {
		${ClassName} model = new ${ClassName}Impl();
		model.setId(toEdit.getId());
		#foreach($Attribute in $Class.getAttributesWithPropertySetSortedByPropertyValue("editor-position"));
		#if(${Attribute.getTypeName()} == "LocalDate")
		model.set${Attribute.getNameCamelCase()}(DateTimeUtil.dateFromString(textField${Attribute.getNameCamelCase()}.getText()));
		#elseif(${Attribute.getTypeName()} == "LocalTime")
		model.set${Attribute.getNameCamelCase()}(DateTimeUtil.timeFromString(textField${Attribute.getNameCamelCase()}.getText()));
		#elseif(${Attribute.getTypeName()} == "boolean")
		model.set${Attribute.getNameCamelCase()}(checkBox${Attribute.getNameCamelCase()}.isSelected());
		#elseif(${Attribute.getTypeName()} == "byte[]")
		model.set${Attribute.getNameCamelCase()}(uploadField${Attribute.getNameCamelCase()}.hasContent() ? uploadField${Attribute.getNameCamelCase()}.getContent() : toEdit.get${Attribute.getNameCamelCase()}());
		#elseif(${Attribute.getTypeName()} == "int")
		model.set${Attribute.getNameCamelCase()}((Integer) spinner${Attribute.getNameCamelCase()}.getValue());
		#elseif(${Attribute.getTypeName()} == "BigDecimal")
		model.set${Attribute.getNameCamelCase()}(decimalValueOf(spinner${Attribute.getNameCamelCase()}));
		#elseif(${Attribute.isReference()} == true)
		model.set${Attribute.getNameCamelCase()}(((${Attribute.getTypeClassType().getName()}) comboBox${Attribute.getNameCamelCase()}.getSelectedItem()));
		#elseif(${Attribute.isTypeEnum()} == true)
		model.set${Attribute.getNameCamelCase()}(((${Attribute.getTypeName()}) comboBox${Attribute.getNameCamelCase()}.getSelectedItem()));
		#else
		model.set${Attribute.getNameCamelCase()}(textField${Attribute.getNameCamelCase()}#if(${Attribute.hasPropertyWithValue("nullable", "true")}).getText().isEmpty() ? null : textField${Attribute.getNameCamelCase()}#end .getText());
