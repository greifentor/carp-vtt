		model.setOwner(userConfiguration.getUserId());
		#end
		#if ($Class.hasPropertyWithNameAndValue("owner-logic", "public-private"))
		model.setOwner(UserContext.isManagePublicRightSet() && checkBoxPublic.isSelected() ? null : UserContext.getUserId());
